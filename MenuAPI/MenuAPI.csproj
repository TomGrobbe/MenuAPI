<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <DebugType>embedded</DebugType>
    <TargetName>MenuAPI</TargetName>
    <Configurations>Release FiveM;Debug FiveM</Configurations>

    <AssemblyTitle>MenuAPI FiveM Enhanced</AssemblyTitle>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <Authors>Tom Grobbe</Authors>
    <Description>An advanced Menu API for FiveM (Enhanced) C# resources.</Description>
    <Copyright>Copyright Tom Grobbe 2018-2026</Copyright>
    <PackageLicenseExpression></PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/tomgrobbe/menuapi/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/tomgrobbe/menuapi/</RepositoryUrl>
    <PackageId>MenuAPI.FiveM.Enhanced</PackageId>
    <PackageTags>FiveM Enhanced MenuAPI</PackageTags>
    <LangVersion>default</LangVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release FiveM'">
    <DefineConstants>FIVEM</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug FiveM'">
    <DefineConstants>FIVEM;DEBUG</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\shared\Controls.cs" Link="Controls.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CitizenFX.FiveM.Client" Version="0.0.2-alpha" />
  </ItemGroup>

</Project>
