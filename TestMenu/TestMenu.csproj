<Project Sdk="Microsoft.NET.Sdk">

  <!-- Shared settings (langversion, nullable, ...) live in ../Directory.Build.props. -->
  <PropertyGroup>
    <!-- net10.0 runs on FiveM Enhanced, net452 on FiveM Legacy. -->
    <TargetFrameworks>net10.0;net452</TargetFrameworks>
    <TargetFrameworks Condition="'$(NativeHooks)' == 'true'">net10.0</TargetFrameworks>

    <TargetName>$(AssemblyName).net</TargetName>

    <!-- The .deps.json file is not used, so don't generate it during build. -->
    <GenerateDependencyFile>false</GenerateDependencyFile>

    <!-- Not shipped anywhere, so nothing consumes the XML docs or the package. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <!--
      FiveM has no host to resolve NuGet assemblies from the package cache, so MenuAPI.dll and the
      CitizenFX assemblies have to sit next to TestMenu.net.dll in the resource folder.
    -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net452'">
    <!-- Same reason as in MenuAPI.csproj, the net10.0 build already checks for nulls. -->
    <Nullable>annotations</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MenuAPI\MenuAPI.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <Compile Remove="platform/legacy/**" />

    <PackageReference Include="CitizenFX.FiveM.Client" />

    <None Include="fxmanifest.lua" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net452'">
    <Compile Remove="platform/enhanced/**" />

    <Using Remove="System.Net.Http" />

    <PackageReference Include="CitizenFX.Core.Client" ExcludeAssets="runtime" />
    <PackageReference Include="PolySharp" PrivateAssets="all" />

    <None Include="fxmanifest.legacy.lua" TargetPath="fxmanifest.lua" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <None Include="index.html" CopyToOutputDirectory="PreserveNewest" />
    <None Include="themes/**/*" CopyToOutputDirectory="PreserveNewest" />
    <None Include="menuapi-banners/**/*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    fxmanifest.lua only lists what every configuration produces. A NativeHooks build also
    drops MenuAPI.NativeHooks.dll in the output, and FiveM loads nothing that the manifest
    does not name, so the entry is added to the copy in the output folder. The source is
    copied over first, otherwise a rebuild would append the same block a second time.
  -->
  <Target Name="AddNativeHooksToManifest" AfterTargets="Build" Condition="'$(NativeHooks)' == 'true' And '$(TargetFramework)' != ''">
    <ItemGroup>
      <_NativeHooksManifestLine Include="-- Added by the NativeHooks build configuration." />
      <_NativeHooksManifestLine Include="files { 'MenuAPI.NativeHooks.dll' }" />
    </ItemGroup>
    <Copy SourceFiles="fxmanifest.lua" DestinationFolder="$(OutDir)" />
    <WriteLinesToFile File="$(OutDir)fxmanifest.lua" Lines="@(_NativeHooksManifestLine)" Overwrite="false" />
  </Target>

</Project>
